// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum WalletType {
  CASH
  BANK
  EWALLET
  DIGITAL_BANK
  CREDIT_CARD
  PAYLATER
  INVESTMENT
  ASSET
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionSource {
  WEB
  WHATSAPP
  SYSTEM
}

enum TransactionConfirmationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum BudgetStatus {
  DRAFT
  SAFE
  OVERPLANNED
  LOCKED
}

enum SavingLedgerType {
  ADD
  WITHDRAW
  ADJUSTMENT
}

enum DebtType {
  RECEIVABLE
  PAYABLE
}

enum DebtStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

model User {
  id                String    @id @default(cuid())
  clerkUserId       String?   @unique @map("clerk_user_id")
  email             String    @unique
  name              String
  role              UserRole  @default(USER)
  pinHash           String?   @map("pin_hash")
  pinSetAt          DateTime? @map("pin_set_at")
  pinFailedAttempts Int       @default(0) @map("pin_failed_attempts")
  pinLockedUntil    DateTime? @map("pin_locked_until")

  wallets          Wallet[]
  transactions     Transaction[]
  budgets          Budget[]
  budgetCategories BudgetCategory[]
  budgetMonths     BudgetMonth[]
  savingLedgers    SavingLedger[]
  debts            Debt[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Wallet {
  id             String     @id @default(cuid())
  userId         String     @map("user_id")
  key            String
  name           String
  type           WalletType @default(OTHER)
  initialBalance Int        @default(0) @map("initial_balance")
  currentBalance Int        @default(0) @map("current_balance")
  isDefault      Boolean    @default(false) @map("is_default")

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[] @relation("TransactionWallet")
  transferTransactions Transaction[] @relation("TransactionTransferWallet")
  debts                Debt[]
  debtPayments         DebtPayment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@unique([userId, name])
  @@index([userId])
  @@map("wallets")
}

model Category {
  id           String          @id @default(cuid())
  parentId     String?         @map("parent_id")
  key          String
  name         String
  group        String
  type         TransactionType
  level        Int             @default(0)
  isSelectable Boolean         @default(true) @map("is_selectable")
  isFallback   Boolean         @default(false) @map("is_fallback")
  isHidden     Boolean         @default(false) @map("is_hidden")

  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, type])
  @@index([parentId])
  @@index([type, group])
  @@map("categories")
}

model Budget {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  legacyCategoryId String?  @map("category_id")
  budgetCategoryId String?  @map("budget_category_id")
  month            DateTime
  amount           Int

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetCategory BudgetCategory? @relation(fields: [budgetCategoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, month, budgetCategoryId])
  @@index([month])
  @@index([budgetCategoryId])
  @@map("budgets")
}

model BudgetCategory {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isHidden  Boolean @default(false) @map("is_hidden")

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets            Budget[]
  budgetMonthEntries BudgetMonthEntry[]
  transactions       Transaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, isHidden])
  @@map("budget_categories")
}

model BudgetMonth {
  id                String       @id @default(cuid())
  userId            String       @map("user_id")
  month             DateTime
  availableToBudget Decimal      @default(0) @map("available_to_budget")
  budgetedAmount    Decimal      @default(0) @map("budgeted_amount")
  unallocatedAmount Decimal      @default(0) @map("unallocated_amount")
  overplannedAmount Decimal      @default(0) @map("overplanned_amount")
  status            BudgetStatus @default(DRAFT)
  strictMode        Boolean      @default(false) @map("strict_mode")

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries BudgetMonthEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, month])
  @@index([userId])
  @@index([month])
  @@map("budget_months")
}

model BudgetMonthEntry {
  id               String  @id @default(cuid())
  budgetMonthId    String  @map("budget_month_id")
  budgetCategoryId String  @map("budget_category_id")
  amount           Decimal

  budgetMonth    BudgetMonth    @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  budgetCategory BudgetCategory @relation(fields: [budgetCategoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([budgetMonthId, budgetCategoryId])
  @@index([budgetMonthId])
  @@index([budgetCategoryId])
  @@map("budget_month_entries")
}

model Transaction {
  id                 String                        @id @default(cuid())
  userId             String                        @map("user_id")
  walletId           String                        @map("wallet_id")
  transferToWalletId String?                       @map("transfer_to_wallet_id")
  categoryId         String?                       @map("category_id")
  budgetCategoryId   String?                       @map("budget_category_id")
  budgetMonth        DateTime?                     @map("budget_month")
  type               TransactionType
  amount             Int
  savingsAmount      Int                           @default(0) @map("savings_amount")
  budgetableAmount   Int                           @default(0) @map("budgetable_amount")
  description        String
  source             TransactionSource             @default(WEB)
  rawMessage         String?                       @map("raw_message")
  confirmationStatus TransactionConfirmationStatus @default(CONFIRMED) @map("confirmation_status")
  transactionDate    DateTime                      @default(now()) @map("transaction_date")
  isPrepaid          Boolean                       @default(false) @map("is_prepaid")

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet           Wallet          @relation("TransactionWallet", fields: [walletId], references: [id])
  transferToWallet Wallet?         @relation("TransactionTransferWallet", fields: [transferToWalletId], references: [id])
  category         Category?       @relation(fields: [categoryId], references: [id])
  budgetCategory   BudgetCategory? @relation(fields: [budgetCategoryId], references: [id], onDelete: SetNull)
  savingLedgers    SavingLedger[]  @relation("SavingsSourceTransaction")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, transactionDate])
  @@index([walletId])
  @@index([categoryId])
  @@index([budgetCategoryId])
  @@index([budgetMonth])
  @@map("transactions")
}

model SavingLedger {
  id                  String           @id @default(cuid())
  userId              String           @map("user_id")
  type                SavingLedgerType
  amount              Decimal
  note                String?
  date                DateTime         @map("date")
  sourceTransactionId String?          @map("source_transaction_id")

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTransaction Transaction? @relation("SavingsSourceTransaction", fields: [sourceTransactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([date])
  @@index([type])
  @@index([sourceTransactionId])
  @@map("saving_ledgers")
}

model Debt {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  walletId   String?    @map("wallet_id")
  personName String     @map("person_name")
  type       DebtType
  amount     Int
  note       String?
  date       DateTime
  dueDate    DateTime?  @map("due_date")
  status     DebtStatus @default(UNPAID)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet   Wallet?       @relation(fields: [walletId], references: [id], onDelete: SetNull)
  payments DebtPayment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([date])
  @@index([dueDate])
  @@map("debts")
}

model DebtPayment {
  id       String   @id @default(cuid())
  debtId   String   @map("debt_id")
  walletId String?  @map("wallet_id")
  amount   Int
  note     String?
  date     DateTime

  debt   Debt    @relation(fields: [debtId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([debtId])
  @@index([walletId])
  @@index([date])
  @@map("debt_payments")
}
